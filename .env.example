#copy to .env for local dev: cp .env.example .env
#REal env vars ALWAYS override .env. Never commit a real .env

FLOWFORGE_DEBUG=true
FLOWFORGE_ENVIRONMENT=local

#must match docker-conpose service creds below
FLOWFORGE_DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge
FLOWFORGE_REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible) — matches docker-compose minio service
FLOWFORGE_S3_ENDPOINT_URL=http://localhost:9000
FLOWFORGE_S3_ACCESS_KEY=flowforge
FLOWFORGE_S3_SECRET_KEY=flowforge
FLOWFORGE_S3_BUCKET=flowforge-artifacts
FLOWFORGE_S3_REGION=us-east-1
FLOWFORGE_S3_PRESIGN_TTL_SECONDS=3600
FLOWFORGE_S3_ENABLED=true

# Celery retry policy (exponential backoff: 30s → 60s → 120s → 240s cap)
FLOWFORGE_RETRY_BACKOFF_BASE_SECONDS=30
FLOWFORGE_RETRY_BACKOFF_MAX_SECONDS=240
FLOWFORGE_RETRY_MAX_RETRIES=4
FLOWFORGE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
FLOWFORGE_CIRCUIT_BREAKER_OPEN_SECONDS=60

# Email (Mailtrap for dev — https://mailtrap.io → SMTP credentials)
FLOWFORGE_EMAIL_ENABLED=false
FLOWFORGE_EMAIL_PROVIDER=smtp
FLOWFORGE_EMAIL_FROM=flowforge@localhost
FLOWFORGE_SMTP_HOST=sandbox.smtp.mailtrap.io
FLOWFORGE_SMTP_PORT=2525
FLOWFORGE_SMTP_USERNAME=
FLOWFORGE_SMTP_PASSWORD=
FLOWFORGE_SMTP_USE_TLS=true
# Production: FLOWFORGE_EMAIL_PROVIDER=ses and FLOWFORGE_EMAIL_FROM=verified@yourdomain.com
FLOWFORGE_SES_REGION=us-east-1

# Prometheus metrics (/metrics on API — scraped by docker prometheus service)
FLOWFORGE_METRICS_ENABLED=true

# Locust load tests (optional — see load_tests/README.md)
# FLOWFORGE_LOAD_TEST_EMAIL=loadtest@example.com
# FLOWFORGE_LOAD_TEST_PASSWORD=supersecret123
# Local only — auto-promote registered users to developer for load tests:
# FLOWFORGE_LOAD_TEST_AUTO_DEVELOPER_ROLE=true